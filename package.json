{
  "name": "geotour-genoroots",
  "version": "1.2.0",
  "private": true,
  "description": "Front-end assets for the GeoTour GenoRoots family-tree plugin",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
